{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kafka": {
    "Consumers": {
      "LogsConsumer": {
        "BootstrapServers": "localhost:9092,localhost:9094,localhost:9095",
        "GroupId": "parsed-logs-handlers",
        "Topic": "logs.parsed",
        "BatchSize": 100,
        "BatchMaxWaitMs": 1000,
        "PollTimeoutMs": 200,
        "EnableAutoCommit": false,
        "AutoOffsetReset": "earliest"
      }
    }
  },
  "ClickHouse": {
    "ConnectionString": "Host=localhost;Port=8123;Database=logly;User=default;Password=default;Compress=True",
    "Table": "logs",
    "BatchSize": 100
  }
}
