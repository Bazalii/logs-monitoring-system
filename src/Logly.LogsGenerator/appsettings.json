{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kafka": {
    "Producers": {
      "LogsProducer": {
        "BootstrapServers": "localhost:9092,localhost:9094,localhost:9095",
        "ClientId": "raw-logs-producer",
        "Topic": "logs.raw",
        "LingerMs": 5,
        "BatchSize": 100
      }
    }
  }
}
